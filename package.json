{
  "name": "wealthmanager",
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "test:tz": "TZ=Asia/Kolkata jest --runInBand && TZ=UTC jest --runInBand",
    "lint": "eslint .",
    "vendor:pdf": "node scripts/vendor-pdf.cjs",
    "format": "prettier --write \"**/*.{js,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,json}\"",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-sms-listener": "^0.8.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-get-sms-android": "^2.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "13.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "fast-check": "3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "3.10.1",
    "react-test-renderer": "19.1.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "data/**/*.js",
      "!utils/PdfBundle.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 66,
        "branches": 55,
        "functions": 75,
        "lines": 67
      },
      "./utils/TransactionParser.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/BalanceService.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/AccountResolver.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/TransferPairing.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/WalletReconcile.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/DeduplicationEngine.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      },
      "./utils/CaptureMapper.js": {
        "statements": 80,
        "branches": 70,
        "functions": 70,
        "lines": 80
      }
    }
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
