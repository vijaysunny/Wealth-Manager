# Gmail sync is off by default (plan B1). Set both to re-enable.
EXPO_PUBLIC_ENABLE_GMAIL=false
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# AI assistant (Gemini Flash / Groq / xAI Grok). Built in; still off until switched on in
# Settings → AI assistant. API KEYS DO NOT GO HERE: every EXPO_PUBLIC_ value is bundled into
# the APK in plain text. Keys are entered in Settings and stored in the Android Keystore.
EXPO_PUBLIC_ENABLE_AI=true
# Fallback order; free tiers first (Gemini AI Studio, Groq), xAI Grok is paid.
EXPO_PUBLIC_AI_PROVIDER_ORDER=gemini,groq,xai
